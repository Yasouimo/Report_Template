{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "./build",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.nav",
    "*.synctex.gz",
    "*.vrb",
    "*.bcf",
    "*.run.xml"
  ],

  "latex-workshop.latex.recipes": [
    // ============================================================
    // DEFAULT RECIPE — PDFLaTeX
    // ============================================================
    {
      "name": "pdflatex → move PDF to root",
      "tools": [
        "pdflatex-to-build",
        "pdflatex-to-build",
        "copy-pdf-to-root"
      ]
    },

    // ============================================================
    // XeLaTeX RECIPE
    // Use this if you need Unicode / custom system fonts.
    // ============================================================
    {
      "name": "xelatex → move PDF to root",
      "tools": [
        "xelatex-to-build",
        "xelatex-to-build",
        "copy-pdf-to-root"
      ]
    }
  ],

  "latex-workshop.latex.tools": [
    // ============================================================
    // PDFLaTeX
    // ============================================================
    {
      "name": "pdflatex-to-build",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=build",
        "%DOC%.tex"
      ]
    },

    // ============================================================
    // XeLaTeX
    // ============================================================
    {
      "name": "xelatex-to-build",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=build",
        "%DOC%.tex"
      ]
    },

    // ============================================================
    // Copy generated PDF from /build to project root
    // ============================================================
    {
      "name": "copy-pdf-to-root",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$doc='%DOC%'; $root=Split-Path -Path $doc -Parent; $name=Split-Path -Path $doc -Leaf; $src=Join-Path (Join-Path $root 'build') ($name + '.pdf'); $dest=Join-Path $root ($name + '.pdf'); if (-not (Test-Path -LiteralPath $src)) { Write-Error \"PDF not found: $src\"; exit 1 }; $ok=$false; for ($i=0; $i -lt 10; $i++) { try { Copy-Item -LiteralPath $src -Destination $dest -Force -ErrorAction Stop; $ok=$true; break } catch { Start-Sleep -Milliseconds 250 } }; if (-not $ok) { Write-Error \"Unable to overwrite $dest because it is locked by another process. Close external PDF viewers and rebuild.\"; exit 1 }; exit 0"
      ]
    }
  ],

  // ==============================================================
  // DEFAULT COMPILER
  //
  // Currently: PDFLaTeX
  //
  // To use XeLaTeX by default, change:
  //
  //   "latex-workshop.latex.recipe.default": "first"
  //
  // to:
  //
  //   "latex-workshop.latex.recipe.default": "lastUsed"
  //
  // Then select "xelatex → move PDF to root" once from:
  // LaTeX Workshop → Build with recipe
  //
  // Or simply keep "first" and manually select the XeLaTeX
  // recipe whenever you need it.
  // ==============================================================

  "latex-workshop.latex.recipe.default": "first",

  "latex-workshop.view.pdf.viewer": "tab"
}
